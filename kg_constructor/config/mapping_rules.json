{
  "mappers": [
    {
      "source": "structured_xml",
      "detector": "indications",
      "subject": "id",
      "predicate_map": [
        {"path": "drug.0.chebi_id", "relation": "has_substance"},
        {"path": "indications.doid_entities", "attr": "doid_id", "relation": "indicated_for"},
        {"path": "contraindications.doid_entities", "attr": "doid_id", "relation": "contraindicated_for"}
      ]
    },
    {
      "source": "orange_book_txt",
      "detector": "Trade_Name",
      "subject": "Trade_Name",
      "predicate_map": [
        {"path": "drug.0.chebi_id", "relation": "has_substance"},
        {"path": "Applicant", "relation": "has_applicant"}
      ]
    },
    {
      "source": "purple_book_csv",
      "detector": "Proprietary Name",
      "subject": "Proprietary Name",
      "predicate_map": [
        {"path": "drug.0.drugbank_id", "relation": "has_substance"},
        {"path": "Proper Name", "relation": "has_proper_name"}
      ]
    },
    {
      "source": "ingredients_json",
      "detector": "ingredients",
      "subject": "id",
      "predicate_map": [
        {"path": "ingredients", "attr": "chebi_id", "relation": "has_substance"},
        {"path": "ingredients", "attr": "drugbank_id", "relation": "has_substance"},
        {"path": "drug", "attr": "chebi_id", "relation": "has_substance"},
        {"path": "drug", "attr": "drugbank_id", "relation": "has_substance"},
        {"path": "organization", "relation": "has_organization"}
      ]
    }
  ],
  "ontology_prefix_filter": [
    "http://purl.obolibrary.org/obo/DOID_",
    "http://purl.obolibrary.org/obo/CHEBI_",
    "https://go.drugbank.com/drugs/"
  ]
}